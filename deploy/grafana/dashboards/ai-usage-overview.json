{
  "title": "AI Usage Exporter — Overview",
  "uid": "ai-usage-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-30d", "to": "now" },
  "tags": ["ai-usage-exporter"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "tool",
        "label": "tool",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "query": "label_values(ai_usage_tokens, tool)",
        "definition": "label_values(ai_usage_tokens, tool)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "model",
        "label": "model",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "query": "label_values(ai_usage_tokens{tool=~\"$tool\"}, model)",
        "definition": "label_values(ai_usage_tokens{tool=~\"$tool\"}, model)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "window",
        "label": "window",
        "type": "custom",
        "query": "1h,24h,7d,30d,mtd,all",
        "options": [
          { "text": "1h", "value": "1h", "selected": false },
          { "text": "24h", "value": "24h", "selected": false },
          { "text": "7d", "value": "7d", "selected": false },
          { "text": "30d", "value": "30d", "selected": true },
          { "text": "mtd", "value": "mtd", "selected": false },
          { "text": "all", "value": "all", "selected": false }
        ],
        "current": { "text": "30d", "value": "30d" },
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 8,
      "type": "stat",
      "title": "Now: tokens (1h)",
      "description": "Total tokens consumed in the last hour. Shows 0 when no model has measured usage; this short window is re-derived from the full history at each scan and is a gauge, not a counter.",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "sum(ai_usage_tokens{window=\"1h\"}) or vector(0)", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "horizontal", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Now: cost (1h)",
      "description": "Estimated cost accumulated in the last hour, calculated using the price catalog current at the latest complete scan. Shows 0 when no model has measured usage.",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "sum(ai_usage_cost_usd{window=\"1h\"}) or vector(0)", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "horizontal", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Now: live usage (1h)",
      "description": "Tokens in the 1h window by tool over time. Includes zero for available providers with no measured usage; availability and freshness indicate failures. Never apply rate() or increase() to this gauge.",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "sum by (tool) (ai_usage_tokens{window=\"1h\"}) or (0 * max by (tool) (ai_usage_provider_available))", "legendFormat": "{{tool}}", "instant": false }],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": {}
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Now: scan freshness",
      "description": "Seconds since the latest complete scan. Green below the default 60-second interval; yellow or red means rescanning is delayed or failing.",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "$datasource" }, "expr": "time() - ai_usage_scan_timestamp_seconds", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 120 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }, "orientation": "horizontal", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Status row",
      "description": "Three status figures for the $window window: total tokens, estimated cost, and distinct sessions. Each is a gauge aggregated from local history during the latest complete scan.",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum(ai_usage_tokens{window=\"$window\", tool=~\"$tool\"})",
          "legendFormat": "Tokens totales",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum(ai_usage_cost_usd{window=\"$window\", tool=~\"$tool\", model=~\"$model\"})",
          "legendFormat": "Coste USD",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum(ai_usage_sessions{window=\"$window\", tool=~\"$tool\"})",
          "legendFormat": "Sesiones",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [{ "id": "unit", "value": "currencyUSD" }]
          }
        ]
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Tokens by tool",
      "description": "Total tokens for the $window window, aggregated by tool without separating model or token class. This is a windowed gauge (ADR-001), not a counter: do not apply rate() or increase() to it.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum by (tool) (ai_usage_tokens{window=\"$window\", tool=~\"$tool\"})",
          "legendFormat": "{{tool}}",
          "instant": true,
          "format": "table"
        }
      ],
      "options": { "orientation": "horizontal", "xTickLabelRotation": 0, "showValue": "always" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Cost by model",
      "description": "Estimated USD cost for the $window window, aggregated by model and ordered descending. Derived from the price catalog current at scan time, not from native cost reported by a provider (docs/metrics.md, 'Reconciliation with native provider cost').",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum by (model) (ai_usage_cost_usd{window=\"$window\", tool=~\"$tool\", model=~\"$model\"})",
          "legendFormat": "{{model}}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "Value", "desc": true }] } }
      ],
      "options": { "orientation": "horizontal", "xTickLabelRotation": 0, "showValue": "always" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "piechart",
      "title": "Token-class distribution",
      "description": "Tokens for the $window window, divided by token_type (input, output, cache_read, cache_write, reasoning). The five classes are contractually disjoint (docs/metrics.md); this donut shows savings from caching directly.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum by (token_type) (ai_usage_tokens{window=\"$window\", tool=~\"$tool\"})",
          "legendFormat": "{{token_type}}",
          "instant": true,
          "format": "table"
        }
      ],
      "options": { "pieType": "donut", "displayLabels": ["percent"], "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] } },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Token trend",
      "description": "ai_usage_tokens{window=\"24h\"} by tool over time. WARNING: this is a windowed gauge, not a counter (ADR-001); never apply rate() or increase(). The line advances with exporter restarts or rescans, not continuously.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum by (tool) (ai_usage_tokens{window=\"24h\", tool=~\"$tool\"})",
          "legendFormat": "{{tool}}",
          "instant": false
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": {}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Month-to-date cost",
      "description": "sum(ai_usage_cost_usd{window=\"mtd\"}) across all tools and models. The month-to-date window is re-derived from local history at every startup (ADR-001); it is not a monotonically increasing counter.",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "sum(ai_usage_cost_usd{window=\"mtd\"})",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Exporter health",
      "description": "Latest startup scan status: availability by provider, files or rows read, parsing errors, scan duration, most recent event timestamp by tool, and build metadata. Every gauge is set at startup (ADR-001).",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "ai_usage_provider_available",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "ai_usage_scan_files",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "ai_usage_scan_errors",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "ai_usage_scan_duration_seconds",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "ai_usage_last_event_timestamp_seconds",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "F",
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "ai_usage_build_info",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": {}
    }
  ]
}
